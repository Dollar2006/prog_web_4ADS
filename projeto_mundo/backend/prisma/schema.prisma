generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(150)
  senha         String    @db.VarChar(255)
  role          String    @default("user") @db.VarChar(50)
  resetToken    String?   @db.VarChar(255) @map("reset_token")
  resetExpires  DateTime? @map("reset_expires")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  @@map("usuario")
}

model Continente {
  id          Int      @id @default(autoincrement())
  nome        String   @unique @db.VarChar(100)
  descricao   String?  @db.Text
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt     @map("atualizado_em")

  paises      Pais[]

  @@map("continente")
}

model Pais {
  id             Int      @id @default(autoincrement())
  nome           String   @unique @db.VarChar(100)
  populacao      BigInt
  idiomaOficial  String   @db.VarChar(100) @map("idioma_oficial")
  moeda          String   @db.VarChar(50)
  idContinente   Int      @map("id_continente")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt      @map("atualizado_em")

  continente     Continente @relation(fields: [idContinente], references: [id], onDelete: Cascade)
  cidades        Cidade[]

  @@index([idContinente])
  @@map("pais")
}

model Cidade {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  populacao    BigInt
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  idPais       Int      @map("id_pais")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt      @map("atualizado_em")

  pais         Pais @relation(fields: [idPais], references: [id], onDelete: Cascade)

  @@index([idPais])
  @@index([latitude, longitude])
  @@map("cidade")
}